# PhishTriage settings (week 3). Copy this file to .env and fill it in.
# .env is git-ignored: never commit it or share it, and keep it private (chmod 600 .env).
# A missing key only switches that one service off; the other lookups still run.
# Check what was read with: phishtriage config   (it never shows the keys)

# VirusTotal API key (free account: 500 lookups a day, 4 a minute)
VT_API_KEY=

# AbuseIPDB API key (free account: 1,000 IP checks a day)
ABUSEIPDB_API_KEY=

# abuse.ch Auth-Key, used for URLhaus (free account)
ABUSECH_AUTH_KEY=

# Your own email addresses, separated by commas. They are removed from every value before
# a lookup, as is every address in an email's To, Cc, Delivered-To and X-Original-To.
PHISHTRIAGE_MY_ADDRESSES=

# Where the lookup cache is kept. The default is outside the project folder on purpose,
# so it can never end up in a zip or a commit.
# PHISHTRIAGE_CACHE=~/.cache/phishtriage/cache.sqlite3
